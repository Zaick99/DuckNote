<Project>

  <!--
    Il framework sta qui e non nei singoli progetti: aggiornarlo e' una riga,
    e nessun progetto puo' restare indietro per distrazione.
  -->
  <PropertyGroup>
    <!-- librerie e test girano ovunque; l'app WPF (solo Windows) lo ridichiara nel suo progetto -->
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Product>DuckNote</Product>
    <Company>DuckNote</Company>
    <Version>0.0.25</Version>
  </PropertyGroup>

</Project>
