<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tutto quello che DuckNote sa fare senza una finestra: riconoscere gli
    indirizzi, leggere il codice, i grafici e le pagine salvate, filtrare ed
    esportare i risultati. Niente WPF qui dentro, cosi' i test girano ovunque.
  -->
  <PropertyGroup>
    <RootNamespace>DuckNote.Notes</RootNamespace>
    <!-- le pagine web (Node) non sono codice della libreria: ne entrano solo i pacchetti costruiti -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Web\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuckNote.Scan\DuckNote.Scan.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- i colori del tema, gli stessi dell'app WPF: servono a riconoscere i colori scritti nelle note -->
    <EmbeddedResource Include="..\DuckNote.App\Theme\tokens.extended.json" Link="Sheets\tokens.extended.json" LogicalName="DuckNote.Notes.tokens.json" />
    <!-- le pagine della mappa e del calendario (Web, "npm run build"), le stesse per Mac e Windows -->
    <EmbeddedResource Include="Web\dist\map.js" LogicalName="DuckNote.Notes.map.js" />
    <EmbeddedResource Include="Web\dist\map.css" LogicalName="DuckNote.Notes.map.css" />
    <EmbeddedResource Include="Web\dist\calendar.js" LogicalName="DuckNote.Notes.calendar.js" />
    <EmbeddedResource Include="Web\dist\calendar.css" LogicalName="DuckNote.Notes.calendar.css" />
  </ItemGroup>

</Project>
