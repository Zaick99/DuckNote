<UserControl x:Class="DuckNote.App.Pages.VaultPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DuckNote.App.Ui"
             xmlns:views="clr-namespace:DuckNote.App.Views">
  <!-- Vive come scheda delle Impostazioni (Embedded: senza intestazione e senza margini) e ne
       segue lo schema: a cifratura attiva due colonne che stanno senza scorrere, ogni riga con
       il testo a sinistra e il controllo a destra (SetRow); i passi della procedura stanno in
       una colonna centrata, con l'illustrazione sopra al contenuto. -->
  <Grid x:Name="Root" Margin="20,2,20,16">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition x:Name="Column" Width="30*" MaxWidth="1100"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="Head" Grid.Column="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Image x:Name="HeadArt" Source="/Assets/art/vault.png" Width="60" Height="60" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
        <TextBlock Text="PROTEZIONE DELLA NOTA" Style="{StaticResource TxtOverline}" Foreground="{DynamicResource Accent}"/>
        <TextBlock Text="Cassaforte" Style="{StaticResource PageTitle}"/>
        <TextBlock x:Name="HeadSub" Style="{StaticResource PageSub}" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>

    <!-- ===================== cifratura attiva ===================== -->
    <ScrollViewer x:Name="PanelOn" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <Grid Margin="0,0,4,8">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="18"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="STATO" Style="{StaticResource SetHeader}" Margin="16,6,0,8"/>
            <Border Style="{StaticResource GroupCard}">
              <StackPanel Margin="0,4">
                <DockPanel Style="{StaticResource SetRow}">
                  <Border DockPanel.Dock="Right" Style="{StaticResource ChipGreen}" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="ATTIVA, APERTA" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Green}"/>
                  </Border>
                  <StackPanel Style="{StaticResource SetText}">
                    <TextBlock Style="{StaticResource SetLabel}" Text="Cifratura"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="La nota e tutto quello che le sta intorno vivono in store.bin."/>
                  </StackPanel>
                </DockPanel>
                <Rectangle Style="{StaticResource SetSep}"/>
                <DockPanel Style="{StaticResource SetRow}">
                  <StackPanel Style="{StaticResource SetText}">
                    <TextBlock Style="{StaticResource SetLabel}" Text="Chiave"/>
                    <TextBlock x:Name="CostText" Style="{StaticResource SetNote}"/>
                  </StackPanel>
                </DockPanel>
                <Rectangle Style="{StaticResource SetSep}"/>
                <DockPanel Style="{StaticResource SetRow}">
                  <TextBox x:Name="LockMinutes" DockPanel.Dock="Right" Style="{StaticResource HintField}" Width="70" TextAlignment="Right" Tag="15"
                           VerticalAlignment="Center" Margin="16,0,0,0" LostFocus="OnLockMinutes"/>
                  <StackPanel Style="{StaticResource SetText}">
                    <TextBlock Style="{StaticResource SetLabel}" Text="Blocca dopo (minuti di inattivita')"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="0 non blocca mai. Ctrl+L blocca subito."/>
                  </StackPanel>
                </DockPanel>
                <Rectangle Style="{StaticResource SetSep}"/>
                <StackPanel Margin="16,12">
                  <TextBlock Style="{StaticResource SetLabel}" Text="Chiudi la cassaforte"/>
                  <TextBlock Style="{StaticResource SetNote}" Text="La nota si salva, la chiave lascia la memoria e serve di nuovo la password."/>
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Style="{StaticResource PrimaryBtn}" Height="32" Click="OnLockNow">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="Blocca adesso" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SoftBtn}" Height="32" Margin="8,0,0,0" Click="OnChangePassword">
                      <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE70F;" Style="{StaticResource Icon}" FontSize="12"/><TextBlock Text="Cambia password" Margin="7,0,0,0"/></StackPanel>
                    </Button>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Border>
            <TextBlock Text="ZONA PERICOLOSA" Style="{StaticResource SetHeader}"/>
            <Border Style="{StaticResource GroupCard}" BorderBrush="{DynamicResource RedBorder}">
              <StackPanel Margin="0,4">
                <DockPanel Style="{StaticResource SetRow}">
                  <Button DockPanel.Dock="Right" Style="{StaticResource DangerBtn}" Content="Togli la cifratura..." VerticalAlignment="Center" Margin="16,0,0,0" Click="OnDecrypt"/>
                  <StackPanel Style="{StaticResource SetText}">
                    <TextBlock Style="{StaticResource SetLabel}" Text="Togli la cifratura"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="La nota torna in chiaro su disco e il contenitore viene distrutto."/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
        </StackPanel>
        <StackPanel Grid.Column="2">
            <TextBlock Text="COSA PROTEGGE" Style="{StaticResource SetHeader}" Margin="16,6,0,8"/>
            <Border Style="{StaticResource NoteBox}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Green}" VerticalAlignment="Top" Margin="2,2,12,0"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Label}" LineHeight="19"
                           Text="Nota, nota precedente, ultima scansione e host messi da parte stanno tutti in store.bin, cifrati con AES-256 e autenticati con HMAC-SHA256. Il contenuto e' riempito a passi di 4 KiB, cosi' la misura del file non dice quanto hai scritto. Mentre la cassaforte esiste nulla viene scritto in chiaro."/>
              </DockPanel>
            </Border>

            <TextBlock Text="COSA NON PROTEGGE" Style="{StaticResource SetHeader}"/>
            <Border Style="{StaticResource ErrorBox}">
              <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="15" Foreground="{DynamicResource Red}" VerticalAlignment="Top" Margin="2,2,12,0"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Label}" LineHeight="19"
                           Text="Un keylogger o un malware nel tuo account, un debugger su DuckNote aperto, un eseguibile sostituito, lo schermo guardato, e le copie in chiaro fatte prima di attivare la cifratura (copie shadow, cronologia file, cartelle sincronizzate). Se perdi la password la nota e' persa: non c'e' recupero."/>
              </DockPanel>
            </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- ===================== procedura per attivare la cifratura ===================== -->
    <Grid x:Name="PanelOff" Grid.Row="1" Grid.Column="1" MaxWidth="780">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border Style="{StaticResource WellBox}" Padding="14,8" Margin="0,6,0,16" HorizontalAlignment="Center">
        <StackPanel x:Name="Stepper" Orientation="Horizontal"/>
      </Border>

      <Grid x:Name="StepHost" Grid.Row="1" ClipToBounds="True">
        <!-- 1. perche' -->
        <ScrollViewer x:Name="StepWhy" VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,0,6,8">
            <DockPanel Margin="4,0,0,4">
              <Image DockPanel.Dock="Left" Source="/Assets/art/lock.png" Width="72" Height="72" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Chiudi la nota a chiave" Style="{StaticResource StepTitle}"/>
                <TextBlock Style="{StaticResource StepText}"
                           Text="Una password trasforma nota, copia precedente, ultima scansione e host messi da parte in un solo contenitore cifrato."/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="COME FUNZIONA" Style="{StaticResource SetHeader}"/>
            <Border Style="{StaticResource GroupCard}">
              <StackPanel Margin="0,4">
                <DockPanel Style="{StaticResource SetRow}">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE8D7;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <StackPanel Style="{StaticResource SetText}">
                    <TextBlock Style="{StaticResource SetLabel}" Text="La password non diventa la chiave"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="Argon2id (256 MiB) e PBKDF2 ne ricavano una chiave che apre soltanto la chiave vera, casuale. Cambiare password riscrive cento byte, non la nota."/>
                  </StackPanel>
                </DockPanel>
                <Rectangle Style="{StaticResource SetSep}"/>
                <DockPanel Style="{StaticResource SetRow}">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <StackPanel Style="{StaticResource SetText}">
                    <TextBlock Style="{StaticResource SetLabel}" Text="La chiave non resta in giro"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="In memoria sta fuori dal garbage collector, bloccata fuori dal file di paging e cifrata quando non serve. Dopo 15 minuti fermi se ne va."/>
                  </StackPanel>
                </DockPanel>
                <Rectangle Style="{StaticResource SetSep}"/>
                <DockPanel Style="{StaticResource SetRow}">
                  <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="16" Foreground="{DynamicResource Red}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <StackPanel Style="{StaticResource SetText}">
                    <TextBlock Style="{StaticResource SetLabel}" Text="Nessun recupero" Foreground="{DynamicResource Red}"/>
                    <TextBlock Style="{StaticResource SetNote}" Text="Non c'e' una chiave di riserva ne' una porta di servizio: e' proprio questo il punto. Se perdi la password, la nota e' persa."/>
                  </StackPanel>
                </DockPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- 2. password -->
        <ScrollViewer x:Name="StepPassword" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="0,0,6,8">
            <DockPanel Margin="4,0,0,4">
              <Image DockPanel.Dock="Left" Source="/Assets/art/password.png" Width="72" Height="72" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Scegli la password" Style="{StaticResource StepTitle}"/>
                <TextBlock Style="{StaticResource StepText}"
                           Text="Almeno otto caratteri. Contro cento GPU da datacenter quattro parole tirate a sorte reggono secoli; 'Estate2026!' qualche minuto."/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="PASSWORD" Style="{StaticResource SetHeader}"/>
            <Border Style="{StaticResource GroupCard}">
              <StackPanel Margin="16,14">
                <TextBlock Style="{StaticResource SetLabel}" Text="Nuova password"/>
                <PasswordBox x:Name="Pwd" Style="{StaticResource PwdField}" Height="36" Margin="0,8,0,0" PasswordChanged="OnPwdChanged"/>
                <views:StrengthBar x:Name="Strength" Margin="2,8,0,0"/>
                <Rectangle Style="{StaticResource SetSep}" Margin="0,14"/>
                <TextBlock Style="{StaticResource SetLabel}" Text="Ripeti la password"/>
                <PasswordBox x:Name="Pwd2" Style="{StaticResource PwdField}" Height="36" Margin="0,8,0,0" KeyDown="OnPwdKey"/>
              </StackPanel>
            </Border>
            <Border x:Name="PwdProblem" Style="{StaticResource ErrorBox}" Margin="0,12,0,0" Visibility="Collapsed">
              <TextBlock x:Name="PwdProblemText" TextWrapping="Wrap" Foreground="{DynamicResource Red}"/>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- 3. riepilogo e forgiatura -->
        <ScrollViewer x:Name="StepConfirm" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="0,0,6,8">
            <DockPanel Margin="4,0,0,4">
              <Image DockPanel.Dock="Left" Source="/Assets/art/vault.png" Width="72" Height="72" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
              <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Pronto" Style="{StaticResource StepTitle}"/>
                <TextBlock Style="{StaticResource StepText}"
                           Text="La chiave si forgia in qualche secondo: e' lento apposta, e lo sara' per chiunque provi a indovinare."/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="RIEPILOGO" Style="{StaticResource SetHeader}"/>
            <Border Style="{StaticResource GroupCard}">
              <StackPanel Margin="0,4">
                <DockPanel Style="{StaticResource SetRow}">
                  <StackPanel Style="{StaticResource SetText}">
                    <TextBlock Style="{StaticResource SetLabel}" Text="Derivazione"/>
                    <TextBlock x:Name="SumCost" Style="{StaticResource SetNote}"/>
                  </StackPanel>
                </DockPanel>
                <Rectangle Style="{StaticResource SetSep}"/>
                <DockPanel Style="{StaticResource SetRow}">
                  <TextBlock DockPanel.Dock="Right" Text="AES-256 + HMAC-SHA256" Style="{StaticResource TxtCaption}" FontFamily="{StaticResource FMono}" VerticalAlignment="Center" Margin="16,0,0,0"/>
                  <StackPanel Style="{StaticResource SetText}">
                    <TextBlock Style="{StaticResource SetLabel}" Text="Contenuto"/>
                  </StackPanel>
                </DockPanel>
                <Rectangle Style="{StaticResource SetSep}"/>
                <DockPanel Style="{StaticResource SetRow}">
                  <CheckBox x:Name="Understood" Style="{StaticResource SwitchDanger}" VerticalAlignment="Center">
                    <StackPanel Style="{StaticResource SetText}">
                      <TextBlock Style="{StaticResource SetLabel}" Text="Ho capito: se perdo la password la nota e' persa"/>
                      <TextBlock Style="{StaticResource SetNote}" Text="Serve la conferma per continuare."/>
                    </StackPanel>
                  </CheckBox>
                </DockPanel>
              </StackPanel>
            </Border>
            <StackPanel x:Name="Forging" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed">
              <ui:Spinner Width="26" Height="26"/>
              <TextBlock x:Name="ForgingText" Style="{StaticResource TxtMuted}" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap" MaxWidth="560"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- fatto -->
        <Grid x:Name="StepDone" Visibility="Collapsed">
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image x:Name="DoneArt" Source="/Assets/art/done.png" Width="160" Height="160" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="La nota e' chiusa a chiave" Style="{StaticResource StepTitle}" FontSize="24" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            <TextBlock Style="{StaticResource StepText}" TextAlignment="Center" MaxWidth="520" HorizontalAlignment="Center"
                       Text="Da ora nulla viene scritto in chiaro, e i file in chiaro di prima sono stati coperti e rimossi. Ogni avvio passera' dalla schermata di sblocco."/>
          </StackPanel>
        </Grid>
      </Grid>

      <Grid x:Name="NavBar" Grid.Row="2" Margin="0,14,0,0">
        <Button x:Name="BtnBack" Style="{StaticResource QuietBtn}" Height="34" HorizontalAlignment="Left" Click="OnBack">
          <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE76B;" Style="{StaticResource Icon}" FontSize="11"/><TextBlock Text="Indietro" Margin="6,0,0,0"/></StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnLater" Style="{StaticResource GhostBtn}" Height="34" Content="Piu' tardi" Margin="0,0,8,0" Click="OnLater"/>
          <Button x:Name="BtnNext" Style="{StaticResource PrimaryBtn}" Height="34" Click="OnNext">
            <StackPanel Orientation="Horizontal"><TextBlock x:Name="TxtNext" Text="Avanti"/><TextBlock Text="&#xE76C;" Style="{StaticResource Icon}" FontSize="11" Margin="7,0,0,0"/></StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
