<Application x:Class="DuckNote.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- i token (pennelli giorno/notte, NON congelati) li inserisce ThemeManager all'indice 0:
             non dichiararli qui, Application.Resources congelerebbe i Freezable -->
        <ResourceDictionary Source="Theme/DuckNote.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</Application>
