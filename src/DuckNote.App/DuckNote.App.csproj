<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>DuckNote.App</RootNamespace>
    <AssemblyName>DuckNote</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\duck.ico</ApplicationIcon>

    <!--
      WPF non regge la modalita' invariante: la cache dei font costruisce
      CultureInfo("en") all'avvio e in quella modalita' non esiste.
    -->
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- la documentazione XML dei pacchetti (WebView2) non va accanto all'eseguibile -->
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <CopyDocumentationFilesFromPackages>false</CopyDocumentationFilesFromPackages>
  </PropertyGroup>

  <ItemGroup>
    <!-- palette giorno/notte letta da ThemeManager con questo nome logico -->
    <EmbeddedResource Include="Theme\tokens.extended.json" LogicalName="Theme.tokens.extended.json" />
    <Resource Include="Assets\*.png" />
    <Resource Include="Assets\art\*.png" />
    <Resource Include="Assets\avatars\*.png" />
    <Resource Include="Assets\duck.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- la mappa della rete e' una pagina web (la stessa del Mac): il motore e' WebView2, gia' in Windows 10 e 11 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DuckNote.Core\DuckNote.Core.csproj" />
    <ProjectReference Include="..\DuckNote.Scan\DuckNote.Scan.csproj" />
    <ProjectReference Include="..\DuckNote.Notes\DuckNote.Notes.csproj" />
  </ItemGroup>

</Project>
