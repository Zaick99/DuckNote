<Window x:Class="DuckNote.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:DuckNote.App.Views"
        Title="DuckNote" Width="1240" Height="800" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="Transparent" Icon="/Assets/duck.ico"
        FontFamily="{StaticResource FText}" FontSize="12.5" TextOptions.TextFormattingMode="Ideal">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="46" CornerRadius="12" GlassFrameThickness="0"
                        ResizeBorderThickness="7" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <!-- Shell Duck: sidebar a tutta altezza (macOS) con semafori, papera + DuckNote, utente;
       Rete in cima, i fogli della nota al centro (NavigatorHost), in fondo la scheda del
       monitoraggio (con il pulsante degli host, CommandsHost) e l'ingranaggio delle Impostazioni. A destra barra del titolo con
       sole/luna, pagina, barra di stato, paperelle e notifiche. Le voci si registrano dal
       codice (AddPage), indice e comandi li fornisce la NotesPage. -->
  <Border x:Name="RootBorder" Background="{DynamicResource BgWindow}"
          BorderBrush="{DynamicResource Separator}" BorderThickness="1" CornerRadius="12">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="266"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===================== sidebar ===================== -->
      <Border Background="{DynamicResource BgSidebarGlass}" BorderBrush="{DynamicResource Separator}" BorderThickness="0,0,1,0" CornerRadius="11,0,0,11">
        <DockPanel>
          <!-- la fascia dei semafori: i pulsanti stanno nello strato TitleLayer, sopra a tutto -->
          <Border DockPanel.Dock="Top" Height="46"/>

          <!-- marchio: la papera e il nome, come in Duck Printer Manager -->
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,0,12,12">
            <Image x:Name="BrandLogo" Source="/Assets/duck.png" Width="34" Height="34" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="BrandName" Text="DuckNote" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Label}"
                       VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>

          <!-- utente corrente: la sua papera (una per iniziale), il nome, il computer e lo stato della cassaforte -->
          <Button x:Name="BtnAccount" DockPanel.Dock="Top" Style="{StaticResource AccountBtn}" Margin="12,0,12,10" Click="OnAccount" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Grid Width="38" Height="38" VerticalAlignment="Center">
                <Ellipse x:Name="AccountPhoto" Width="38" Height="38"/>
                <Border x:Name="AccountBadge" Width="17" Height="17" CornerRadius="8.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,-3,-3" BorderThickness="2" BorderBrush="{DynamicResource BgFieldAlt}" Background="{DynamicResource LabelQuaternary}">
                  <TextBlock x:Name="AccountBadgeGlyph" Text="&#xE785;" Style="{StaticResource Icon}" FontSize="7.5" HorizontalAlignment="Center"
                             Foreground="{DynamicResource LabelOnAccent}"/>
                </Border>
              </Grid>
              <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="AccountName" FontWeight="SemiBold" Foreground="{DynamicResource Label}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="AccountSub" Style="{StaticResource TxtCaption}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="AccountVault" Style="{StaticResource TxtCaption}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
              </StackPanel>
            </Grid>
          </Button>

          <!-- in cima: Rete -->
          <StackPanel x:Name="NavTop" DockPanel.Dock="Top"/>

          <!-- in fondo: la scheda del monitoraggio, con il pulsante che controlla gli host dei fogli -->
          <Grid DockPanel.Dock="Bottom" Margin="12,6,12,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="StatusCard" Style="{StaticResource WellBox}" Padding="11,8" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="CardDot" Width="8" Height="8" Fill="{DynamicResource Green}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="CardTitle" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Label}" Margin="7,0,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="CardRight" Grid.Column="1" Style="{StaticResource TxtCaption}" VerticalAlignment="Center" Margin="6,0,4,0"/>
                  <ContentControl x:Name="CommandsHost" Grid.Column="2" Focusable="False" VerticalAlignment="Center"/>
                </Grid>
                <ProgressBar x:Name="CardProgress" Margin="0,8,0,6" Maximum="1"/>
                <TextBlock x:Name="CardText" Style="{StaticResource TxtCaption}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>
          <Rectangle DockPanel.Dock="Bottom" Height="1" Fill="{DynamicResource SeparatorSoft}" Margin="16,0"/>

          <!-- al centro: i fogli e i loro titoli H1/H2 -->
          <ContentControl x:Name="NavigatorHost" Focusable="False"/>
        </DockPanel>
      </Border>

      <!-- ===================== contenuto ===================== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="46"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="26"/>
        </Grid.RowDefinitions>
        <Canvas x:Name="DuckLayer" Grid.RowSpan="3" ClipToBounds="True" IsHitTestVisible="False" Background="Transparent"/>


        <ContentControl x:Name="PageHost" Grid.Row="1" Focusable="False"/>

        <Border Grid.Row="2" BorderBrush="{DynamicResource SeparatorSoft}" BorderThickness="0,1,0,0">
          <TextBlock x:Name="StatusText" Style="{StaticResource TxtCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="22,0"/>
        </Border>

        <StackPanel x:Name="ToastHost" Grid.RowSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,18,0" Panel.ZIndex="20"/>
      </Grid>

      <!-- il menu dell'utente (e del lucchetto): blocca la nota o esci; senza cifratura propone
           di impostarla e porta in Impostazioni > Cassaforte -->
      <Popup x:Name="AccountMenu" StaysOpen="False" AllowsTransparency="True" Placement="Bottom" PopupAnimation="Fade">
        <Border Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource Separator}" BorderThickness="1"
                CornerRadius="12" Padding="6" Width="250" Margin="10,4,10,14">
          <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.18" Color="Black"/>
          </Border.Effect>
          <StackPanel>
            <TextBlock x:Name="MenuTitle" FontWeight="SemiBold" Foreground="{DynamicResource Label}" Margin="10,8,10,0"/>
            <TextBlock x:Name="MenuText" Style="{StaticResource TxtCaption}" TextWrapping="Wrap" Margin="10,3,10,8"/>
            <Button x:Name="MenuLock" Style="{StaticResource MenuRow}" Click="OnMenuLock">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Orange}"/>
                <TextBlock Text="Blocca la nota" Margin="10,0,0,0"/>
                <TextBlock Text="Ctrl+L" Style="{StaticResource TxtCaption}" Margin="10,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
            <Button x:Name="MenuVault" Style="{StaticResource MenuRow}" Click="OnMenuVault">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Accent}"/>
                <TextBlock Text="Imposta la cifratura..." Margin="10,0,0,0"/>
              </StackPanel>
            </Button>
            <Rectangle x:Name="MenuSep" Height="1" Fill="{DynamicResource SeparatorSoft}" Margin="8,4"/>
            <Button x:Name="MenuExit" Style="{StaticResource MenuRow}" Click="OnMenuExit">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Red}"/>
                <TextBlock Text="Esci da DuckNote" Margin="10,0,0,0"/>
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>
      </Popup>

      <!-- schermata di sblocco: copre tutta la finestra -->
      <views:LockScreen x:Name="Lock" Grid.ColumnSpan="2" Visibility="Collapsed" Panel.ZIndex="10"/>

      <!-- la barra in cima, sopra a tutto (anche alla schermata di blocco, che cosi' copre la
           finestra intera con un colore solo): semafori a sinistra; versione, lucchetto e
           giorno/notte a destra -->
      <Grid x:Name="TitleLayer" Grid.ColumnSpan="2" Height="46" VerticalAlignment="Top" Panel.ZIndex="11">
        <Grid HorizontalAlignment="Left" Margin="16,0,0,0">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource TrafficBtn}" Background="{DynamicResource TLClose}" ToolTip="Chiudi" Click="OnClose" VerticalAlignment="Center">
                <Path Data="M 0,0 L 6,6 M 6,0 L 0,6" Stroke="{DynamicResource TrafficGlyph}" StrokeThickness="1.2" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Button>
              <Button Style="{StaticResource TrafficBtn}" Background="{DynamicResource TLMin}" ToolTip="Riduci a icona" Click="OnMin" VerticalAlignment="Center">
                <Path Data="M 0,3 L 7,3" Stroke="{DynamicResource TrafficMinGlyph}" StrokeThickness="1.2" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Button>
              <Button Style="{StaticResource TrafficBtn}" Background="{DynamicResource TLZoom}" ToolTip="Ingrandisci" Click="OnMax" VerticalAlignment="Center">
                <Path Data="M 0,3 L 7,3 M 3.5,0 L 3.5,6.5" Stroke="{DynamicResource TrafficZoomGlyph}" StrokeThickness="1.2" Stretch="Uniform" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Button>
            </StackPanel>
        </Grid>
        <Grid HorizontalAlignment="Right" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <!-- come in Duck Printer Manager: la versione, poi lucchetto, Impostazioni e giorno/notte,
                 tre pulsanti della stessa misura (30x28) con icone da 14 -->
              <TextBlock x:Name="StatusRight" Style="{StaticResource TxtCaption}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="BtnLock" Style="{StaticResource Toolbtn}" Width="30" Height="28" Padding="0" VerticalAlignment="Center" Margin="0,0,2,0"
                      Click="OnLockButton" AutomationProperties.Name="Blocca la nota">
                <TextBlock x:Name="LockGlyph" Text="&#xE785;" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
              <Button x:Name="BtnSettings" Style="{StaticResource Toolbtn}" Width="30" Height="28" Padding="0" VerticalAlignment="Center" Margin="0,0,2,0"
                      Click="OnSettings" ToolTip="Impostazioni" AutomationProperties.Name="Impostazioni">
                <TextBlock x:Name="SettingsGlyph" Text="&#xE713;" Style="{StaticResource Icon}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
              <Button x:Name="BtnTheme" Style="{StaticResource Toolbtn}" Width="30" Height="28" Padding="0" VerticalAlignment="Center" ToolTip="Aspetto chiaro / scuro (clic destro: segui Windows)"
                      Click="OnTheme" MouseRightButtonUp="OnThemeSystem">
                <Path x:Name="ThemeGlyph" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
