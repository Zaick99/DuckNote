<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.MergedDictionaries>
    <!-- Il kit si unisce qui e non accanto: gli StaticResource verso RControl, FIcons... si
         risolvono dentro lo stesso documento, non fra dizionari fratelli. -->
    <ResourceDictionary Source="DuckExtras.xaml"/>
  </ResourceDictionary.MergedDictionaries>

  <!-- Solo cio' che e' di DuckNote: barra dell'editor, struttura delle pagine, tabella degli
       host. Colori sempre da DynamicResource, mai esadecimali. -->

  <!-- ===== barra dell'editor ===== -->
  <!-- Contorno di fuoco: compare solo quando ci si arriva da tastiera (Alt+F10, frecce). -->
  <Style x:Key="FmtFocus">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-1" RadiusX="7" RadiusY="7" StrokeThickness="1.5" Stroke="{DynamicResource Accent}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Comando semplice: si spegne (non sparisce) quando non si puo' usare. -->
  <Style x:Key="FmtBtn" TargetType="Button" BasedOn="{StaticResource Toolbtn}">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FmtFocus}"/>
    <Style.Triggers>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </Style.Triggers>
  </Style>
  <!-- Interruttore (grassetto, titoli, elenchi...): premuto = vale dove sta il cursore. Premuto ha
       fondo e bordo d'accento, il passaggio del mouse solo un grigio: non si confondono. -->
  <Style x:Key="FmtToggle" TargetType="ToggleButton">
    <Setter Property="Width" Value="30"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="Margin" Value="0,0,1,0"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FmtFocus}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" CornerRadius="7" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource BgHover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Label}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
              <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource BgPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FmtText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FText}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="FmtGlyph" TargetType="TextBlock" BasedOn="{StaticResource Icon}">
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="FmtPath" TargetType="Path">
    <Setter Property="Width" Value="14"/>
    <Setter Property="Height" Value="14"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="StrokeThickness" Value="1.4"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
  </Style>
  <Style x:Key="ToolSep" TargetType="Rectangle">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Height" Value="18"/>
    <Setter Property="Margin" Value="6,0"/>
    <Setter Property="Fill" Value="{DynamicResource Separator}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- ===== righe dei moduli (Impostazioni, Cassaforte) =====
       Una riga e' un DockPanel: il controllo agganciato a destra (DockPanel.Dock="Right"), il
       testo che riempie il resto e va a capo. Il testo non finisce mai sotto il controllo, e
       tutti e due stanno centrati in verticale nella stessa altezza minima. -->
  <Style x:Key="SetRow" TargetType="DockPanel">
    <Setter Property="MinHeight" Value="50"/>
    <Setter Property="Margin" Value="16,6"/>
    <Setter Property="LastChildFill" Value="True"/>
  </Style>
  <Style x:Key="SetLabel" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource FText}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SetNote" TargetType="TextBlock" BasedOn="{StaticResource TxtCaption}">
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,3,0,0"/>
  </Style>
  <Style x:Key="SetText" TargetType="StackPanel">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="SetHeader" TargetType="TextBlock" BasedOn="{StaticResource GroupHeader}">
    <Setter Property="Margin" Value="16,22,0,8"/>
  </Style>
  <Style x:Key="SetFooter" TargetType="TextBlock" BasedOn="{StaticResource GroupFooter}">
    <Setter Property="Margin" Value="16,8,16,0"/>
  </Style>
  <Style x:Key="SetSep" TargetType="Rectangle">
    <Setter Property="Height" Value="1"/>
    <Setter Property="Margin" Value="16,0"/>
    <Setter Property="Fill" Value="{DynamicResource SeparatorSoft}"/>
  </Style>

  <!-- ===== il foglio della nota ===== -->
  <!-- Titolo della pagina scritto direttamente sul foglio: nessuna cornice, segnaposto in Tag. -->
  <Style x:Key="TitleField" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource FText}"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Grid>
            <TextBlock x:Name="hint" Text="{TemplateBinding Tag}" Foreground="{DynamicResource LabelQuaternary}"
                       FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                       Padding="2,0,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
            <ScrollViewer x:Name="PART_ContentHost"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="hint" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== righe della struttura e dell'elenco host ===== -->
  <Style x:Key="OutlineItem" TargetType="ListBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
    <Setter Property="Margin" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="6,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="b" CornerRadius="{StaticResource RRow}" Background="Transparent"
                  Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource BgHover}"/>
              <Setter Property="Foreground" Value="{DynamicResource Label}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
              <Setter Property="Foreground" Value="{DynamicResource Label}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Voce della sidebar senza pillola che scorre: Rete in cima e Impostazioni in fondo stanno in
       due pannelli diversi, quindi la voce attiva si colora da sola, come i fogli dell'indice. -->
  <Style x:Key="NavItem" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    <Setter Property="FontFamily" Value="{StaticResource FText}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="Margin" Value="10,1"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}"/></Trigger>
            <Trigger Property="Tag" Value="Active">
              <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
              <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBorder}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Solo icona (l'ingranaggio delle Impostazioni): nessun contorno, ne' al passaggio del
       mouse ne' a pagina aperta; la tessera basta da sola. -->
  <Style x:Key="IconNavItem" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Padding="3" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Riga di un menu a comparsa (il menu dell'utente): icona e testo, grigio al passaggio. -->
  <Style x:Key="MenuRow" TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="10,8">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource BgHover}"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="{DynamicResource BgPressed}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== tabella degli host ===== -->
  <Style x:Key="GridHeader" TargetType="DataGridColumnHeader">
    <Setter Property="Background" Value="{DynamicResource TableHeaderBg}"/>
    <Setter Property="Foreground" Value="{DynamicResource LabelSecondary}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridColumnHeader">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SeparatorSoft}"
                    BorderThickness="0,0,1,1" Padding="{TemplateBinding Padding}">
              <StackPanel Orientation="Horizontal">
                <ContentPresenter VerticalAlignment="Center"/>
                <TextBlock x:Name="arrow" Style="{StaticResource Icon}" FontSize="8" Margin="6,0,0,0"
                           Foreground="{DynamicResource Accent}" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
            <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Width="6" Cursor="SizeWE" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="SortDirection" Value="Ascending">
              <Setter TargetName="arrow" Property="Text" Value="&#xE70E;"/>
              <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="SortDirection" Value="Descending">
              <Setter TargetName="arrow" Property="Text" Value="&#xE70D;"/>
              <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="GridRow" TargetType="DataGridRow">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridRow">
          <Border x:Name="row" Background="{TemplateBinding Background}" BorderBrush="Transparent"
                  BorderThickness="3,0,0,0" SnapsToDevicePixels="True">
            <DataGridCellsPresenter ItemsPanel="{TemplateBinding ItemsPanel}"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="row" Property="Background" Value="{DynamicResource AccentSoft}"/>
              <Setter TargetName="row" Property="BorderBrush" Value="{DynamicResource AccentFill}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ItemsControl.AlternationIndex" Value="1">
        <Setter Property="Background" Value="{DynamicResource BgRowAlt}"/>
      </Trigger>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource BgHover}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="GridCell" TargetType="DataGridCell">
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    <Setter Property="TextBlock.TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="DataGridCell">
          <Border Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="HostGrid" TargetType="DataGrid">
    <Setter Property="AutoGenerateColumns" Value="False"/>
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="CanUserAddRows" Value="False"/>
    <Setter Property="HeadersVisibility" Value="Column"/>
    <Setter Property="GridLinesVisibility" Value="Horizontal"/>
    <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource SeparatorSoft}"/>
    <Setter Property="SelectionMode" Value="Single"/>
    <Setter Property="SelectionUnit" Value="FullRow"/>
    <Setter Property="AlternationCount" Value="2"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="RowStyle" Value="{StaticResource GridRow}"/>
    <Setter Property="CellStyle" Value="{StaticResource GridCell}"/>
    <Setter Property="ColumnHeaderStyle" Value="{StaticResource GridHeader}"/>
    <Setter Property="EnableRowVirtualization" Value="True"/>
    <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>

  <Style TargetType="GridSplitter">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Width" Value="6"/>
    <Setter Property="Cursor" Value="SizeWE"/>
    <Setter Property="Focusable" Value="False"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource AccentSoft}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
