<UserControl x:Class="DuckNote.App.Views.LockScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:DuckNote.App.Ui">
  <!-- La schermata di sblocco copre tutta la finestra, barra in cima compresa (i semafori, la
       versione e giorno/notte le stanno sopra): la papera, il titolo, la password.
       Mentre la chiave si forgia, al posto del modulo gira un normale indicatore di caricamento. -->
  <Grid x:Name="Root">
    <Grid.RowDefinitions>
      <RowDefinition Height="46"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- un colore solo su tutta la finestra, barra in cima compresa, con gli stessi angoli -->
    <Border x:Name="Back" Grid.RowSpan="2" Background="{DynamicResource BgGrouped}" CornerRadius="11"/>

    <StackPanel x:Name="Stage" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Width="360" Margin="0,0,0,40">
      <StackPanel.RenderTransform><TranslateTransform x:Name="StageMove"/></StackPanel.RenderTransform>

      <Image Source="/Assets/duck.png" Width="96" Height="96" HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>

      <TextBlock Text="La nota e' chiusa a chiave" Style="{StaticResource PageTitle}" FontSize="22" HorizontalAlignment="Center" Margin="0,20,0,0"/>
      <TextBlock x:Name="Sub" Style="{StaticResource PageSub}" HorizontalAlignment="Center" TextAlignment="Center"
                 Text="Serve la password per aprirla."/>

      <!-- modulo e caricamento occupano lo stesso posto: niente salti quando si alternano -->
      <Grid Margin="0,22,0,0" MinHeight="66">
        <StackPanel x:Name="Form">
          <StackPanel.RenderTransform><TranslateTransform x:Name="FormMove"/></StackPanel.RenderTransform>
          <TextBlock x:Name="PwdLabel" Text="PASSWORD" Style="{StaticResource GroupHeader}" Margin="2,0,0,6"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="Pwd" Style="{StaticResource PwdField}" Height="40" FontSize="15" KeyDown="OnKey"/>
            <Button x:Name="BtnOpen" Grid.Column="1" Style="{StaticResource PrimaryBtn}" Height="40" Width="56" Margin="8,0,0,0"
                    Click="OnOpen" ToolTip="Apri (Invio)">
              <TextBlock Text="&#xE72A;" Style="{StaticResource Icon}" FontSize="14"/>
            </Button>
          </Grid>
        </StackPanel>

        <ui:Spinner x:Name="Loading" Width="40" Height="40" Thickness="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="Collapsed"/>
      </Grid>

      <TextBlock x:Name="Work" Style="{StaticResource TxtMuted}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                 Margin="0,14,0,0" Visibility="Collapsed"/>
      <TextBlock x:Name="Message" FontWeight="SemiBold" Foreground="{DynamicResource Red}" HorizontalAlignment="Center"
                 TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
    </StackPanel>
  </Grid>
</UserControl>
