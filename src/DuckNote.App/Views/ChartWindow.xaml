<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DuckNote.App.Views.ChartWindow"
        Title="Grafico" Width="700" Height="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" UseLayoutRounding="True"
        FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="Transparent">
  <Border x:Name="CRoot" CornerRadius="14" Background="{DynamicResource BgSidebarGlass}"
          RenderTransformOrigin="0.5,0.45" Opacity="0">
    <Border.RenderTransform>
      <TransformGroup>
        <ScaleTransform x:Name="CScale" ScaleX="0.96" ScaleY="0.96"/>
        <TranslateTransform x:Name="CMove" Y="12"/>
      </TransformGroup>
    </Border.RenderTransform>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="44"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Border x:Name="CTitleBar" Grid.Row="0" Background="{DynamicResource BgToolbarGlass}" CornerRadius="13,13,0,0">
        <Grid>
          <Button x:Name="CClose" Style="{DynamicResource TrafficBtn}" Background="{DynamicResource TLClose}"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="Chiudi (Esc)">
            <Path Data="M 0,0 L 6,6 M 6,0 L 0,6" Stroke="#5A1416" StrokeThickness="1.2" Stretch="Uniform"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
          </Button>
          <TextBlock Text="Numeri del grafico" FontSize="13" FontWeight="SemiBold"
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Foreground="{DynamicResource Label}"/>
        </Grid>
      </Border>

      <Grid Grid.Row="1" Margin="22,16,22,4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="270"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
          <TextBlock DockPanel.Dock="Top" Text="Una riga per valore: etichetta e numero."
                     FontSize="12" Margin="2,0,0,7" Foreground="{DynamicResource LabelSecondary}"/>
          <TextBlock DockPanel.Dock="Bottom" FontSize="11" Margin="2,8,0,0" TextWrapping="Wrap"
                     Text="In cima puoi scrivere tipo: barre, linea o torta, e titolo: come si chiama."
                     Foreground="{DynamicResource LabelTertiary}"/>
          <Border CornerRadius="8" Background="{DynamicResource SheetScrim}" Padding="4">
            <TextBox x:Name="CText" AcceptsReturn="True" AcceptsTab="False" BorderThickness="0"
                     Background="Transparent" VerticalScrollBarVisibility="Auto"
                     FontFamily="SF Mono, Cascadia Mono, Consolas" FontSize="12.5"
                     Foreground="{DynamicResource Label}" Padding="7,5"
                     CaretBrush="{DynamicResource Label}"/>
          </Border>
        </DockPanel>

        <Border Grid.Column="1" Margin="16,0,0,0" CornerRadius="8" Padding="2"
                BorderThickness="1" BorderBrush="{DynamicResource TableBorder}">
          <ContentControl x:Name="CPreview"/>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="{DynamicResource BgToolbarGlass}" Padding="18,12" CornerRadius="0,0,13,13"
              Margin="0,14,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="CCancel" Style="{DynamicResource QuietBtn}" Content="Annulla" Margin="0,0,8,0"/>
          <Button x:Name="COk" Style="{DynamicResource PrimaryBtn}" Content="Salva"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
