<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DuckNote.App.Views.PreferencesWindow"
        Title="Impostazioni" Width="560" Height="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" AllowsTransparency="True" UseLayoutRounding="True"
        FontFamily="SF Pro Text, Segoe UI Variable Text, Segoe UI" FontSize="13"
        Background="Transparent">

  <Window.Resources>
    <Style x:Key="Head" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource LabelTertiary}"/>
      <Setter Property="Margin" Value="4,0,0,7"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Background" Value="{DynamicResource SheetScrim}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource SeparatorSoft}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,20"/>
    </Style>

    <Style x:Key="Line" TargetType="Grid">
      <Setter Property="Margin" Value="15,11,15,11"/>
    </Style>

    <Style x:Key="Name" TargetType="TextBlock">
      <Setter Property="Width" Value="238"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource Label}"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Foreground" Value="{DynamicResource LabelTertiary}"/>
      <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>

    <Style x:Key="Rule" TargetType="Rectangle">
      <Setter Property="Height" Value="1"/>
      <Setter Property="Fill" Value="{DynamicResource SeparatorSoft}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
  </Window.Resources>

  <Border x:Name="PRoot" CornerRadius="14" Background="{DynamicResource BgSidebarGlass}"
          RenderTransformOrigin="0.5,0.45" Opacity="0">
  <Border.RenderTransform>
    <TransformGroup>
      <ScaleTransform x:Name="PScale" ScaleX="0.96" ScaleY="0.96"/>
      <TranslateTransform x:Name="PMove" Y="12"/>
    </TransformGroup>
  </Border.RenderTransform>
  <Grid Margin="0">
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border x:Name="PTitleBar" Grid.Row="0" Background="{DynamicResource BgToolbarGlass}" CornerRadius="13,13,0,0">
      <Grid>
        <Button x:Name="PClose" Style="{DynamicResource TrafficBtn}" Background="{DynamicResource TLClose}"
                HorizontalAlignment="Left" VerticalAlignment="Center" Margin="14,0,0,0" ToolTip="Chiudi">
          <Path Data="M 0,0 L 6,6 M 6,0 L 0,6" Stroke="#5A1416" StrokeThickness="1.2" Stretch="Uniform"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
        </Button>
        <TextBlock Text="Impostazioni" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                   VerticalAlignment="Center" Foreground="{DynamicResource Label}"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,18,16,6">
      <StackPanel>

        <TextBlock Style="{StaticResource Head}" Text="ASPETTO"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Style="{StaticResource Line}">
              <CheckBox x:Name="PSysTheme" Content="Segui l'aspetto di sistema" VerticalAlignment="Center"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <TextBlock Style="{StaticResource Name}" Text="Tema"/>
              <ComboBox x:Name="PTheme" Width="150" Height="27" HorizontalAlignment="Right">
                <ComboBoxItem Content="Chiaro" Tag="light"/>
                <ComboBoxItem Content="Scuro"  Tag="dark"/>
              </ComboBox>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <CheckBox x:Name="PLiveFmt" Content="Formattazione Markdown dal vivo" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Head}" Text="PAPERE SULLO SFONDO"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Style="{StaticResource Line}">
              <CheckBox x:Name="PDucks" Content="Papere animate" VerticalAlignment="Center"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <TextBlock Style="{StaticResource Name}" Text="Quante"/>
              <TextBox x:Name="PDuckN" Style="{DynamicResource Field}" Width="92"
                       TextAlignment="Right" HorizontalAlignment="Right"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <TextBlock Style="{StaticResource Name}" Text="Intensita' (%)"/>
              <TextBox x:Name="PDuckOp" Style="{DynamicResource Field}" Width="92"
                       TextAlignment="Right" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Head}" Text="SALVATAGGIO DELLA NOTA"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Style="{StaticResource Line}">
              <CheckBox x:Name="PAutosave" Content="Salvataggio automatico" VerticalAlignment="Center"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <TextBlock Style="{StaticResource Name}" Text="Attesa prima di salvare (ms)"/>
              <TextBox x:Name="PAutoMs" Style="{DynamicResource Field}" Width="92"
                       TextAlignment="Right" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Head}" Text="SICUREZZA"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Style="{StaticResource Line}">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="PSecDot" Width="9" Height="9" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBlock x:Name="PSecState" FontWeight="SemiBold" VerticalAlignment="Center"
                             Foreground="{DynamicResource Label}"/>
                </StackPanel>
                <TextBlock x:Name="PSecInfo" Style="{StaticResource Hint}" Margin="17,6,0,0"/>
              </StackPanel>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <StackPanel>
                <Grid>
                  <TextBlock Style="{StaticResource Name}" Text="Blocca dopo (minuti)"/>
                  <TextBox x:Name="PLockMin" Style="{DynamicResource Field}" Width="92"
                           TextAlignment="Right" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="PLockInfo" Style="{StaticResource Hint}"
                           Text="Senza tocchi a tastiera e mouse per questo tempo, la chiave lascia la memoria e serve di nuovo la password. 0 non blocca mai."/>
              </StackPanel>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="PSecOn"  Style="{DynamicResource PrimaryBtn}" Content="Attiva cifratura" Margin="0,0,8,0"/>
                <Button x:Name="PSecPwd" Style="{DynamicResource QuietBtn}"   Content="Cambia password" Margin="0,0,8,0"/>
                <Button x:Name="PSecOff" Style="{DynamicResource QuietBtn}"   Content="Disattiva"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Head}" Text="MONITORAGGIO"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Style="{StaticResource Line}">
              <CheckBox x:Name="PMonitor" Content="Controlla periodicamente gli host della nota"
                        VerticalAlignment="Center"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <TextBlock Style="{StaticResource Name}" Text="Intervallo (secondi)"/>
              <TextBox x:Name="PMonSec" Style="{DynamicResource Field}" Width="92"
                       TextAlignment="Right" HorizontalAlignment="Right"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Head}" Text="SCANSIONE"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Style="{StaticResource Line}">
              <StackPanel>
                <Grid>
                  <TextBlock Style="{StaticResource Name}" Text="Host analizzati insieme"/>
                  <TextBox x:Name="PThreads" Style="{DynamicResource Field}" Width="92"
                           TextAlignment="Right" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Quanti host vengono presi in carico nello stesso momento."/>
              </StackPanel>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <StackPanel>
                <Grid>
                  <TextBlock Style="{StaticResource Name}" Text="Connessioni aperte insieme"/>
                  <TextBox x:Name="PSockets" Style="{DynamicResource Field}" Width="92"
                           TextAlignment="Right" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Tetto complessivo alle porte TCP provate nello stesso istante, da tutti gli host insieme. Alzare gli host senza alzare questo non rende: Windows ha un numero finito di porte di partenza."/>
              </StackPanel>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <TextBlock Style="{StaticResource Name}" Text="Ping per host"/>
              <TextBox x:Name="PPingN" Style="{DynamicResource Field}" Width="92"
                       TextAlignment="Right" HorizontalAlignment="Right"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <TextBlock Style="{StaticResource Name}" Text="Timeout del ping (ms)"/>
              <TextBox x:Name="PPingMs" Style="{DynamicResource Field}" Width="92"
                       TextAlignment="Right" HorizontalAlignment="Right"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <TextBlock Style="{StaticResource Name}" Text="Timeout di una porta (ms)"/>
              <TextBox x:Name="PPortMs" Style="{DynamicResource Field}" Width="92"
                       TextAlignment="Right" HorizontalAlignment="Right"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <StackPanel>
                <TextBlock Text="Porte da verificare" Foreground="{DynamicResource Label}"/>
                <TextBox x:Name="PPorts" Style="{DynamicResource Field}" Height="54" Margin="0,6,0,0"
                         TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="8,5"/>
              </StackPanel>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <CheckBox x:Name="PDead" Content="Analizza anche gli host che non rispondono al ping"
                        VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Head}" Text="COSA RACCOGLIERE SU OGNI HOST"/>
        <Border Style="{StaticResource Card}">
          <StackPanel>
            <Grid Style="{StaticResource Line}">
              <StackPanel>
                <CheckBox x:Name="PDns" Content="Nome host via DNS inverso"/>
                <Grid Margin="22,9,0,0">
                  <TextBlock Text="Server DNS" Width="110" VerticalAlignment="Center" FontSize="12"
                             Foreground="{DynamicResource LabelSecondary}"/>
                  <TextBox x:Name="PDnsServer" Style="{DynamicResource Field}" Width="150"
                           HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Margin="22,5,0,0" Text="Vuoto: quello di sistema."/>
              </StackPanel>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <CheckBox x:Name="PNetBios" Content="Nome, gruppo e MAC via NetBIOS" VerticalAlignment="Center"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <CheckBox x:Name="PMdns" Content="Nome via mDNS (Bonjour)" VerticalAlignment="Center"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <CheckBox x:Name="PSsdp" Content="Descrizione del dispositivo via SSDP/UPnP" VerticalAlignment="Center"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <CheckBox x:Name="PBanner" Content="Banner dei servizi, titolo web e certificato TLS"
                        VerticalAlignment="Center"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <StackPanel>
                <CheckBox x:Name="PSnmp" Content="Interrogazione SNMP v2c"/>
                <Grid Margin="22,9,0,0">
                  <TextBlock Text="Community" Width="110" VerticalAlignment="Center" FontSize="12"
                             Foreground="{DynamicResource LabelSecondary}"/>
                  <TextBox x:Name="PCommunity" Style="{DynamicResource Field}" Width="150"
                           HorizontalAlignment="Right"/>
                </Grid>
              </StackPanel>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <CheckBox x:Name="PShares" Content="Elenco delle condivisioni SMB (piu' lento)"
                        VerticalAlignment="Center"/>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <StackPanel>
                <CheckBox x:Name="PWmi" Content="Inventario via WMI/WinRM (richiede permessi)"/>
                <TextBlock Style="{StaticResource Hint}" Margin="22,6,0,0"
                           Text="WMI usa le credenziali dell'utente corrente. Su host non di dominio serve un account locale abilitato."/>
              </StackPanel>
            </Grid>
            <Rectangle Style="{StaticResource Rule}"/>
            <Grid Style="{StaticResource Line}">
              <StackPanel>
                <Button x:Name="POui" Style="{DynamicResource QuietBtn}"
                        Content="Aggiorna il database dei produttori (IEEE)" HorizontalAlignment="Left"/>
                <TextBlock x:Name="POuiInfo" Style="{StaticResource Hint}"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Head}" Text="VERIFICA DEL CODICE"/>
        <Border Style="{StaticResource Card}">
          <Grid Style="{StaticResource Line}">
            <StackPanel>
              <TextBlock Style="{StaticResource Hint}" Margin="0"
                         Text="SHA-256 di quel che e' in esecuzione, da confrontare con le somme pubblicate con la release."/>
              <TextBox x:Name="PFinger" Style="{DynamicResource Field}" Margin="0,8,0,0" Height="46"
                       IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="8,5"
                       FontFamily="SF Mono, Cascadia Mono, Consolas" FontSize="11.5"/>
              <TextBlock x:Name="PFingerPath" Style="{StaticResource Hint}" Margin="2,6,0,0"
                         FontFamily="SF Mono, Cascadia Mono, Consolas" FontSize="10.5"/>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock Style="{StaticResource Head}" Text="DISINSTALLAZIONE"/>
        <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource RedBorder}">
          <Grid Style="{StaticResource Line}">
            <StackPanel>
              <TextBlock Text="Cancella nota, backup, impostazioni, scansioni e chiave: tutto il contenuto di %APPDATA%\DuckNote."
                         FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Label}"/>
              <TextBlock Style="{StaticResource Hint}"
                         Text="I byte dei file vengono sovrascritti prima della cancellazione. L'operazione non si annulla."/>
              <Button x:Name="PWipe" Style="{DynamicResource QuietBtn}" Content="Cancella tutti i dati..."
                      HorizontalAlignment="Left" Margin="0,12,0,0" Foreground="{DynamicResource Red}"/>
            </StackPanel>
          </Grid>
        </Border>

        <TextBlock x:Name="PError" Foreground="{DynamicResource Red}" FontSize="12" TextWrapping="Wrap"
                   Margin="4,0,0,4"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource BgToolbarGlass}" Padding="18,12" CornerRadius="0,0,13,13"
            BorderBrush="{DynamicResource SeparatorSoft}" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="PCancel" Style="{DynamicResource QuietBtn}" Content="Annulla" Margin="0,0,8,0"/>
        <Button x:Name="POk"     Style="{DynamicResource PrimaryBtn}" Content="Salva"/>
      </StackPanel>
    </Border>
  </Grid>
  </Border>
</Window>
