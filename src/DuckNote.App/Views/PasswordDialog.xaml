<Window x:Class="DuckNote.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DuckNote.App.Ui"
        xmlns:views="clr-namespace:DuckNote.App.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        SizeToContent="Height" Width="520" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FontFamily="{StaticResource FText}" FontSize="12.5" Title="Cambia password">
  <Border x:Name="Root" Margin="18" Background="{DynamicResource BgElevated}" BorderBrush="{DynamicResource Separator}"
          BorderThickness="1" CornerRadius="{StaticResource RPanel}" Opacity="0" RenderTransformOrigin="0.5,0.5">
    <Border.RenderTransform>
      <TransformGroup><ScaleTransform/><TranslateTransform/></TransformGroup>
    </Border.RenderTransform>
    <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.35" Color="Black"/>
    </Border.Effect>
    <Grid Margin="22,18,22,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Image Source="/Assets/art/password.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Cambia password" Style="{StaticResource TxtSub}"/>
          <TextBlock Style="{StaticResource TxtCaption}" TextWrapping="Wrap"
                     Text="Cambia solo l'involucro della chiave: il contenuto resta dov'e'."/>
        </StackPanel>
      </Grid>

      <StackPanel x:Name="Form" Grid.Row="1">
        <TextBlock Text="NUOVA PASSWORD" Style="{StaticResource GroupHeader}" Margin="2,0,0,6"/>
        <PasswordBox x:Name="Pwd" Style="{StaticResource PwdField}" Height="36" PasswordChanged="OnChanged"/>
        <views:StrengthBar x:Name="Strength" Margin="2,8,0,0"/>
        <TextBlock Text="RIPETILA" Style="{StaticResource GroupHeader}" Margin="2,16,0,6"/>
        <PasswordBox x:Name="Pwd2" Style="{StaticResource PwdField}" Height="36" KeyDown="OnKey"/>
        <Border x:Name="Problem" Style="{StaticResource ErrorBox}" Margin="0,12,0,0" Visibility="Collapsed">
          <TextBlock x:Name="ProblemText" TextWrapping="Wrap" Foreground="{DynamicResource Red}"/>
        </Border>
        <StackPanel x:Name="Forging" Orientation="Horizontal" Margin="2,14,0,0" Visibility="Collapsed">
          <ui:Spinner Width="22" Height="22"/>
          <TextBlock x:Name="ForgingText" Style="{StaticResource TxtMuted}" VerticalAlignment="Center" Margin="10,0,0,0" TextWrapping="Wrap" MaxWidth="400"/>
        </StackPanel>
      </StackPanel>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
        <Button x:Name="BtnCancel" Style="{StaticResource QuietBtn}" Content="Annulla" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
        <Button x:Name="BtnOk" Style="{StaticResource PrimaryBtn}" Content="Cambia password" Click="OnOk"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
